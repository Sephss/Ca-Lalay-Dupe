<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="@android:color/white" />

    <!-- Border / stroke -->
    <stroke
        android:width="1dp"
        android:color="#B0B0B0" /> <!-- light grey -->

    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Optional padding inside -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />

</shape>