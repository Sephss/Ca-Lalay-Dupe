<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- reddish translucent glass tint -->
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#B3FF3B33"
        android:centerColor="#A6E8322C"
        android:endColor="#99CC2A25" />

    <!-- pill shape -->
    <corners android:radius="30dp" />

    <!-- subtle light edge to sell the "glass" highlight -->
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />

</shape>