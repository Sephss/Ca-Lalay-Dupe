<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.shopowner.ShopOwnerViewShopRatings">

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/back" />

        <TextView
            android:id="@+id/theShopName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Shop Ratings"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:padding="20dp"
        android:id="@+id/linearLayout17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shop_ratings_bg"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout4">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shopName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/overallRatings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_marginEnd="10dp"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:gravity="bottom"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/starOne"
                        android:layout_marginEnd="5dp"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/white_star"
                        />

                    <ImageView
                        android:id="@+id/startwo"
                        android:layout_marginEnd="5dp"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/white_star"
                        />

                    <ImageView
                        android:id="@+id/starthree"
                        android:layout_marginEnd="5dp"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/white_star"
                        />

                    <ImageView
                        android:id="@+id/starfour"
                        android:layout_marginEnd="5dp"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/white_star"
                        />

                    <ImageView
                        android:id="@+id/starfive"
                        android:layout_marginEnd="5dp"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/white_star"
                        />

                </LinearLayout>


            </LinearLayout>

       <LinearLayout
           android:layout_marginTop="10dp"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="vertical">
           <TextView
               android:id="@+id/totalReviewsCount"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="0"
               android:textColor="@color/white"
               android:textSize="18sp"
               android:textStyle="bold" />
           <TextView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="Total Reviews"
               android:textColor="@color/white"
               android:textSize="15sp"
             />
       </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/horizontalScrollView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout17">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/allTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/rating_filter_bg_selected"
                android:text="All"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fiveStarTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/rating_filter_bg"
                android:text="5 star"
                android:textColor="@color/semiblack"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fourStarTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/rating_filter_bg"
                android:text="4 star"
                android:textColor="@color/semiblack"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/threeStarTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/rating_filter_bg"
                android:text="3 star"
                android:textColor="@color/semiblack"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/twoStarTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/rating_filter_bg"
                android:text="2 star"
                android:textColor="@color/semiblack"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/oneStarTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/rating_filter_bg"
                android:text="1 star"
                android:textColor="@color/semiblack"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ratingsRV"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView" />


</androidx.constraintlayout.widget.ConstraintLayout>