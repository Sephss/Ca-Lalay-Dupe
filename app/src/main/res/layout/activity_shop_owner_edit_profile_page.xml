<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.shopowner.ShopOwnerEditProfilePage">

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/back" />

        <TextView
            android:id="@+id/theShopName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit details"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/selectImage"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/sent_image_placeholder"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.498"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViews" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Tap to change photo"
                android:textColor="@color/semiblack"
                android:textSize="14sp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/selectImage">
                <TextView
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BUSINESS INFORMATION"
                    android:layout_marginStart="40dp"
                    android:textStyle="bold"
                    android:textColor="@color/red"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif-black"
                    android:text="New Business Name *"
                    android:textColor="@color/semiblack"
                    android:textSize="12sp" />
                <EditText
                    android:id="@+id/shopName"
                    android:maxLength="100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Enter new business name"
                    android:padding="13dp"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif-black"
                    android:text="New Location *"
                    android:textColor="@color/semiblack"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/selectLocation"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="10dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:background="@drawable/get_location_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="5dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:gravity="center"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" >
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="10dp"
                                android:src="@drawable/location_red"/>
                            <TextView
                                android:id="@+id/vehicleName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Select Location"
                                android:textColor="@color/red"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:gravity="end"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <ImageView
                                    android:id="@+id/trashIcon"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/arrow_red"/>
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>



                </LinearLayout>

                <LinearLayout
                    android:visibility="gone"
                    android:id="@+id/newLocationSelected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginBottom="15dp"
                    android:layout_marginEnd="40dp"
                    android:background="@drawable/get_location_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:gravity="center"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" >
                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:layout_marginEnd="10dp"
                                android:src="@drawable/baseline_warning_24"/>
                            <TextView
                                android:id="@+id/retreivedLocationTV"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NEW LOCATION SELECTED!"
                                android:textColor="@color/red"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:gravity="end"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
                <EditText
                    android:id="@+id/shopLocation"
                    android:maxLength="100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Enter new location"
                    android:padding="13dp"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BUSINESS INFORMATION"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="30dp"
                    android:textStyle="bold"
                    android:textColor="@color/red"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Contact Number *"
                    android:textColor="@color/semiblack"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/shopContactNum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:inputType="number"
                    android:maxLength="11"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Enter new contact number"
                    android:padding="13dp"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif-black"
                    android:text="New Open At *"
                    android:textColor="@color/semiblack"
                    android:textSize="12sp" />
                <EditText
                    android:id="@+id/shopOpenAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Enter new open at"

                    android:padding="13dp"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif-black"
                    android:text="New Closed At *"
                    android:textColor="@color/semiblack"
                    android:textSize="12sp" />
                <EditText
                    android:id="@+id/shopClosedAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Enter new closed at"
                    android:padding="13dp"
                    android:textSize="14sp" />

              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal">
                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginStart="40dp"
                      android:textStyle="bold"
                      android:layout_marginBottom="5dp"
                      android:fontFamily="sans-serif-black"
                      android:text="New Shop Slot *"
                      android:textColor="@color/semiblack"
                      android:textSize="12sp" />

                  <TextView
                      android:id="@+id/whatisShopSlot"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginStart="10dp"
                      android:layout_marginBottom="10dp"
                      android:text="@string/what_is_shop_slot"
                      android:textStyle="bold"
                      android:fontFamily="sans-serif-black"
                      android:textColor="@color/black"
                      android:textSize="12sp"
                      android:clickable="true"
                      android:focusable="true" />

              </LinearLayout>
                <EditText
                    android:id="@+id/shopSlot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Enter new shop slot"
                    android:padding="13dp"
                    android:inputType="number"
                    android:textSize="14sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif-black"
                    android:text="New About *"
                    android:textColor="@color/semiblack"
                    android:textSize="12sp" />
                <EditText
                    android:id="@+id/shopDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginBottom="15dp"
                    android:maxLength="1000"
                    android:background="@drawable/edittext_rounded"
                    android:gravity="top|start"
                    android:hint="Enter new about"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minHeight="150dp"
                    android:padding="13dp"
                    android:scrollbars="vertical"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Operating Days *"
                    android:textColor="@color/semiblack"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginBottom="8dp"
                    android:text="Uncheck the days your shop is closed. Customers won't be able to book on unchecked days."
                    android:textColor="@color/semiblack"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/operatingDaysLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/edittext_rounded"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <CheckBox
                        android:id="@+id/dayMonday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Monday"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/dayTuesday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Tuesday"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/dayWednesday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Wednesday"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/dayThursday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Thursday"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/dayFriday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Friday"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/daySaturday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Saturday"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/daySunday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Sunday"
                        android:textSize="14sp" />

                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"

                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif-black"
                    android:text="SPECIAL CLOSED DATES"
                    android:textColor="@color/red"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginBottom="8dp"
                    android:text="Add specific dates your shop will be closed (e.g. renovation, holiday). Customers will see the reason when they try to book that date."
                    android:textColor="@color/semiblack"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/selectClosedDateRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/edittext_rounded"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="13dp">

                    <TextView
                        android:id="@+id/closedDateText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tap to select a date"
                        android:textColor="@color/semiblack"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/arrow_red" />

                </LinearLayout>

                <EditText
                    android:id="@+id/closedDateReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Reason (e.g. Shop under renovation)"
                    android:maxLength="150"
                    android:padding="13dp"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/addClosedDateBtn"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginBottom="15dp"
                    android:background="@drawable/add_closed_date_bg"
                    android:text="Add Closed Date"
                    android:textColor="@color/red"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/closedDatesListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginBottom="15dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/passwordHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="40dp"
                    android:text="Use 8+ characters with uppercase, lowercase, number, and symbol."
                    android:textColor="#808080"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/red"
                    android:textSize="14dp"
                    android:visibility="gone" />


                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/loadingAnimation"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/loader" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/saveBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="40dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="40dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/rounded_btn_registration"
                        android:text="Save"
                        android:textColor="@color/semiwhite"
                        android:textSize="18dp" />

                    <TextView
                        android:id="@+id/errorPrompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="sans-serif-black"
                        android:text="Incorrect email or password"
                        android:textColor="@color/red"
                        android:textSize="17dp"
                        android:visibility="gone" />


                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>